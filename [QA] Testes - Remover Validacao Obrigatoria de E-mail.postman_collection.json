        {
          "name": "[SMOKE]  Criação de lead com e-mail inválido (sucesso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Success true\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json.success).to.be.true;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Mensagem de sucesso correta\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json.message).to.eql(\"Lead recebido com sucesso.\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Error é null\", function () {\r",
                  "    const json = pm.response.json();\r",
